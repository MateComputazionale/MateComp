Cell[TextData[{
 "Abbiamo deciso di generare casualmente i valori di \[OpenCurlyQuote]",
 StyleBox["a",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote] e \[OpenCurlyQuote]",
 StyleBox["b",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote], con \[OpenCurlyQuote]",
 StyleBox["a",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote] compreso tra 10 e 99, e \[OpenCurlyQuote]",
 StyleBox["b",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote] compreso tra 1 e \[OpenCurlyQuote]",
 StyleBox["a",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]. Questa scelta \[EGrave] stata fatta per evitare che l\
\[CloseCurlyQuote]utente selezioni numeri troppo grandi, il che potrebbe \
rendere eccessivamente lunga l\[CloseCurlyQuote]esecuzione dell\
\[CloseCurlyQuote]algoritmo."
}], "Item",
 CellChangeTimes->{{3.956134147139564*^9, 3.956134160951611*^9}, 
   3.956136379034754*^9},
 TextJustification->1.,ExpressionUUID->"1fbedbbf-a717-426a-8d2b-45dfde4b3a74"]
