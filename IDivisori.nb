}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Approfondimento - Diagramma pacchetti", "Section",
 CellChangeTimes->{{3.956130419749023*^9, 3.9561304489650087`*^9}, {
  3.9561393047468147`*^9, 
  3.9561393071283245`*^9}},ExpressionUUID->"ed0c5d57-ffdd-404e-a9a4-\
ef36a7431f1e"],

Cell[TextData[{
 "Di seguito viene riportato il ",
 StyleBox["diagramma delle dipendenze",
  FontWeight->"Bold"],
 " dei pacchetti utilizzati. Ad esempio l\[CloseCurlyQuote]arco che parte dal \
pacchetto",
 StyleBox[" IDivisori.m",
  FontSlant->"Italic"],
 " e termina in ",
 StyleBox["Board.m",
  FontSlant->"Italic"],
 " significa che nel pacchetto ",
 StyleBox["IDivisori.m",
  FontSlant->"Italic"],
 " viene importato il pacchetto ",
 StyleBox["Board.m",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.956130450088971*^9, 3.956130465322124*^9}, {
   3.9563031573570957`*^9, 3.956303185673553*^9}, {3.9563032256101103`*^9, 
   3.956303293850689*^9}, 
