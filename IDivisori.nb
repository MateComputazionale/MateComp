Cell[CellGroupData[{

Cell["Introduzione", "Section",
 CellChangeTimes->{{3.9561399872409077`*^9, 
  3.9561399890874977`*^9}},ExpressionUUID->"3b996e5d-8186-264c-a595-\
fb41f0f8bf1b"],

Cell[TextData[{
 "L\[CloseCurlyQuote]idea alla base del nostro progetto nasce dal desiderio \
di rendere ",
 StyleBox["l\[CloseCurlyQuote]algoritmo di Euclide",
  FontWeight->"Bold"],
 ", spesso percepito come un concetto ",
 StyleBox["troppo astratto",
  FontSlant->"Italic"],
 ", un\[CloseCurlyQuote]esperienza ",
 StyleBox["concreta, interattiva e divertente",
  FontWeight->"Bold"],
 ". Trasformando il calcolo del ",
 StyleBox["massimo comune divisore",
  FontWeight->"Bold"],
 " in una piccola ",
 StyleBox["\[OpenCurlyDoubleQuote]avventura su scacchiera\
\[CloseCurlyDoubleQuote]",
  FontSlant->"Italic"],
 ", il giocatore pu\[OGrave] esplorare passo dopo passo \
nell\[CloseCurlyQuote]algoritmo come i numeri si riducano alla soluzione \
cercata, consolidando al tempo stesso le basi della ",
 "teoria dei numeri",
 ".\n\nPer raggiungere questo scopo, il gioco integra dinamiche classiche - \
come il lancio del dado e il movimento su caselle - con elementi di ",
 StyleBox["problem solving",
  FontSlant->"Italic"],
 " matematico. A ogni tappa sulla griglia, infatti, si presenta una ",
 StyleBox["coppia di numeri",
  FontWeight->"Bold"],
 " da \[OpenCurlyDoubleQuote]semplificare\[CloseCurlyDoubleQuote] tramite ",
 StyleBox["ripetute sottrazioni o divisioni successive",
  FontVariations->{"Underline"->True}],
 ", guidando l\[CloseCurlyQuote]utente attraverso un ",
 StyleBox["processo logico e intuitivo",
  FontSlant->"Italic"],
 " - eseguendo l\[CloseCurlyQuote]algoritmo di Euclide. La casualit\[AGrave] \
nella creazione dei problemi stimola la ripetizione e mantiene alta la \
curiosit\[AGrave], mentre suggerimenti contestuali e \
un\[CloseCurlyQuote]interfaccia semplice permettono di seguire con facilit\
\[AGrave] ogni passaggio.\n\nGrazie a un design modulare e parametrico, ogni \
partita offre nuovi percorsi e sfide: l\[CloseCurlyQuote]utente potr\[AGrave] \
cimentarsi in pi\[UGrave] sessioni diverse e osservare come variazioni minime \
nei numeri in gioco portino a sequenze di calcolo differenti. In questo modo, \
il progetto non \[EGrave] solo un gioco, ma un vero e proprio ambiente di \
apprendimento, capace di unire rigore matematico e divertimento in un\
\[CloseCurlyQuote]esperienza immediata e stimolante.\n\nIl notebook \[EGrave] \
rivolto agli ",
 StyleBox["studenti delle scuole medie",
  FontWeight->"Bold"],
 " che vogliono consolidare l\[CloseCurlyQuote]apprendimento dell\
\[CloseCurlyQuote]algoritmo di Euclide."
}], "Text",
 CellChangeTimes->{{3.9561399934428673`*^9, 3.956139995161869*^9}, {
   3.956140083615999*^9, 3.9561402482287006`*^9}, {3.956141193625265*^9, 
   3.9561412245722504`*^9}, 3.9563087174455423`*^9, {3.9563108690207863`*^9, 
   3.9563108943371086`*^9}},
 TextJustification->1.,ExpressionUUID->"c2530380-c609-f84e-b419-b4530182415f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Il Massimo Comun Divisore (",
 StyleBox["MCD",
  FontWeight->"Bold"],
 ")"
}], "Section",
 CellChangeTimes->{{3.9554228132890053`*^9, 3.9554228176171923`*^9}, {
  3.9563109306949825`*^9, 
  3.9563109360948696`*^9}},ExpressionUUID->"7d5a9716-7c7e-4345-82cf-\
1e76bdd780af"],

Cell[TextData[{
 StyleBox["Il massimo comun divisore ",
  FontWeight->"Bold"],
 "[1][2] di due numeri interi ",
 StyleBox["a",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " e ",
 StyleBox["b",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", diversi da zero, \[EGrave] il pi\[UGrave] grande numero naturale  che \
divide esattamente sia ",
 StyleBox["a",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " che ",
 StyleBox["b",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " e si indica con ",
 StyleBox["MCD(a,b)",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ".\n Per convenzione, se entrambi i numeri sono uguali a zero, si definisce: \
",
 StyleBox["MCD(0 , 0) = 0",
  FontSlant->"Italic"],
 ".\n\nEsempi:\n",
 StyleBox["MCD(12, 18) = 6\nMCD(4, 14) = 4\nMCD(5, 0) = 5",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.9554228840432673`*^9, 3.95542302869846*^9}, 
   3.9554404817816334`*^9, {3.956139449330063*^9, 3.9561394503491173`*^9}, {
   3.956139662321457*^9, 3.956139662812565*^9}, {3.956290187610052*^9, 
   3.956290311327128*^9}, 3.9562910307917852`*^9, {3.9562913890662613`*^9, 
   3.956291392009099*^9}, {3.956291441318722*^9, 3.9562914715923653`*^9}, 
   3.956311965603092*^9},
 TextJustification->1.,ExpressionUUID->"e7b3011d-dba8-4041-9d15-03768f8a07c7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A cosa serve il Massimo Comune Divisore?", "Section",
 CellChangeTimes->{{3.955423085171443*^9, 3.955423106478513*^9}, {
  3.956311114443342*^9, 
  3.956311118518717*^9}},ExpressionUUID->"8472b0fd-571c-4d3f-9213-\
012491981ce5"],

Cell[TextData[{
 "Il massimo comun divisore",
 " [1][2] \[EGrave] uno strumento ",
 StyleBox["fondamentale",
  FontWeight->"Bold"],
 " in matematica. \nServe, ad esempio, per semplificare una frazione, cio\
\[EGrave] per ridurla ai ",
 StyleBox["minimi termini",
  FontWeight->"Bold"],
 ". Ma non solo: \[EGrave] fondamentale anche quando si lavora con i \
polinomi, perch\[EAcute] permette di raccogliere fattori comuni nelle somme e \
nelle sottrazioni. Inoltre, entra in gioco ogni volta che bisogna dividere \
due o pi\[UGrave] quantit\[AGrave] per lo stesso numero intero, ottenendo un \
risultato senza resto.\n\nNel seguente esempio,",
 StyleBox[" MCD(42,56) = 14",
  FontSlant->"Italic"],
 ". Dividendo il numeratore e il denominatore per 14 otteniamo la frazione \
semplificata ai minimi termini.\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["42", "56"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"3", "\[Cross]", "14"}], 
          RowBox[{"4", "\[Cross]", "14"}]], "\[LongEqual]", 
         FractionBox["3", "4"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{42}{56} = \\frac{3 \\times 14}{ 4 \\times 14} = \\frac{3}{4}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"0fe2805c-240f-4611-b4a6-b4f5024b39f4"]
}], "Text",
 CellChangeTimes->{{3.955423167973701*^9, 3.955423237453393*^9}, 
   3.955426711606308*^9, {3.9554267612830353`*^9, 3.955426761881191*^9}, {
   3.9561394826531124`*^9, 3.956139483370805*^9}, {3.956139665884069*^9, 
   3.956139666523851*^9}, 3.9562903293182974`*^9, {3.956290364092664*^9, 
   3.9562903775000362`*^9}, {3.956290427946949*^9, 3.956290492212428*^9}, {
   3.956290523533161*^9, 3.95629064706538*^9}, {3.956290888085991*^9, 
   3.956290919781836*^9}, {3.956291505504218*^9, 3.95629160371512*^9}, {
   3.9562916376376967`*^9, 3.9562916404494*^9}, 3.9563111503809395`*^9},
 TextJustification->1.,ExpressionUUID->"85bdcf57-5f15-48d6-88a3-d9b07959d1ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell["L\[CloseCurlyQuote]algoritmo di Euclide", "Section",
 CellChangeTimes->{{3.955423548293227*^9, 
  3.955423552950346*^9}},ExpressionUUID->"477b2aa8-b8e7-4c17-8903-\
f31ffc3a634f"],

Cell[TextData[{
 StyleBox["L\[CloseCurlyQuote]algoritmo di Euclide",
  FontWeight->"Bold"],
 " [3][4] (o metodo delle divisioni successive),  consente di calcolare il ",
 StyleBox["massimo comun divisore tra due numeri",
  FontSlant->"Italic"],
 ".\nIl suo funzionamento si basa su una serie di divisioni successive, in \
cui ogni passo riduce il problema fino a trovare la soluzione.\n\n In questo \
diagramma a blocchi \[EGrave] mostrato passo dopo passo come funziona l\
\[CloseCurlyQuote]algoritmo di Euclide:\n"
}], "Text",
 CellChangeTimes->{{3.955423583603159*^9, 3.955423624141577*^9}, {
   3.955426786681447*^9, 3.9554268311093893`*^9}, {3.955440550541685*^9, 
   3.955440560257021*^9}, {3.956139878069933*^9, 3.9561398849072857`*^9}, {
   3.956290982239808*^9, 3.956291019637385*^9}, 3.956291188763793*^9, {
   3.956291221330566*^9, 3.956291310566992*^9}},
 TextJustification->1.,ExpressionUUID->"fd3e8e9c-7c92-4ca7-92f9-63b4111e944a"],

