 ButtonBox["\<\"Inizia il Gioco\"\>",
  Appearance->Automatic,
  ButtonFunction:>IDivisori`StartGame[],
  Evaluator->Automatic,
  Method->"Queued"]], "Output",
 CellChangeTimes->{3.953282904552845*^9, 3.953359665356962*^9},
